{
  "name": "anki-b2",
  "private": true,
  "version": "1.64.10",
  "engines": {
    "node": ">=26.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b --noEmit",
    "check:quick": "npm run type-check && npm run lint:code && npm run lint:data",
    "health:check": "node scripts/health-check.ts",
    "agent:ready": "npm run check:quick && npm run health:check && npm run test:run",
    "preview": "vite preview",
    "lint": "npm run lint:data && npm run lint:code && npm run format:check",
    "lint:code": "eslint .",
    "lint:data": "node scripts/lint-data.ts",
    "lint:mess": "vue-mess-detector analyze src --exclude src/components/ui,*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:all": "npm run type-check && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "npm run test:all && npm run lint:data && npm run build",
    "generate:anki": "node scripts/generate-all-anki.ts",
    "diff:data": "node scripts/diff-data.ts",
    "audit:ui": "node scripts/ui-audit.ts",
    "ci:status": "node scripts/ci-status.ts",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "genankjs": "^1.0.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-mess-detector": "^0.68.1",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
